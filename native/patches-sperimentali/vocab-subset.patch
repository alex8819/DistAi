+// DistAI: copia dei logits; con il vocabolario ridotto il grafo produce solo le colonne del sottoinsieme, qui rimesse nelle posizioni giuste (-inf altrove)
+static void distai_get_logits(ggml_backend_t backend_res, ggml_tensor * t_logits, float * out, int64_t n_rows, int64_t n_vocab) {
+    if (g_vocab_sub.active() && t_logits->ne[0] == (int64_t) g_vocab_sub.ids.size() && t_logits->ne[0] != n_vocab) {
+        const int64_t ns = t_logits->ne[0];
+        std::vector<float> tmp((size_t) (n_rows * ns));
+        ggml_backend_tensor_get_async(backend_res, t_logits, tmp.data(), 0, tmp.size() * sizeof(float));
+        ggml_backend_synchronize(backend_res);
+        for (int64_t r = 0; r < n_rows; r++) {
+            float * o = out + r * n_vocab;
+            std::fill(o, o + n_vocab, -INFINITY);
+            for (int64_t j = 0; j < ns; j++) {
+                o[g_vocab_sub.ids[j]] = tmp[r * ns + j];
+            }
+        }
+        return;
+    }
+    ggml_backend_tensor_get_async(backend_res, t_logits, out, 0, n_rows * n_vocab * sizeof(float));
+}
