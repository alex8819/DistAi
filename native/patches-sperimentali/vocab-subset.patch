diff --git a/src/llama-vocab-sub.h b/src/llama-vocab-sub.h
new file mode 100644
index 0000000..7f25e8f
--- /dev/null
+++ b/src/llama-vocab-sub.h
@@ -0,0 +1,24 @@
+#pragma once
+
+// DistAI: vocabolario ridotto per il calcolo dei logits.
+// Con LLAMA_VOCAB_SUBSET=file (un id di token per riga) il layer di output moltiplica solo per le righe di quei token: nei modelli MoE con pochi
+// parametri attivi la matrice di output (151.936 x 2048, Q6_K, 255 MB) e' circa un quarto dei byte letti per token. I logits degli altri token
+// valgono -inf e non possono essere scelti. Stato globale: un solo modello per processo (llama-server).
+
+#include "ggml.h"
+#include "ggml-backend.h"
+
+#include <cstdint>
+#include <vector>
+
+struct llama_vocab_sub {
+    std::vector<int32_t>      ids;               // id dei token calcolati, ordinati e unici
+    ggml_tensor *             out_orig = nullptr; // pesi di output completi (model.output)
+    ggml_tensor *             out_sub  = nullptr; // righe del sottoinsieme, stesso tipo di quantizzazione
+    ggml_context *            ctx      = nullptr;
+    ggml_backend_buffer_t     buf      = nullptr;
+
+    bool active() const { return out_sub != nullptr; }
+};
+
+extern llama_vocab_sub g_vocab_sub;
