+llama_vocab_sub g_vocab_sub;
+
+// DistAI: costruisce il tensore di output ridotto se LLAMA_VOCAB_SUBSET e' impostata (vedi llama-vocab-sub.h)
+static void distai_build_vocab_sub(llama_model & m) {
+    const char * path = getenv("LLAMA_VOCAB_SUBSET");
+    if (!path || !*path) {
+        return;
+    }
+    if (!m.output || m.output_b || !m.output->buffer) {
+        LLAMA_LOG_WARN("%s: vocabolario ridotto non applicabile (output=%p bias=%p buffer=%p)\n", __func__, (void *) m.output, (void *) m.output_b,
+            m.output ? (void *) m.output->buffer : nullptr);
+        return;
+    }
+    ggml_tensor * out = m.output;
+    const char * bufname = ggml_backend_buffer_name(out->buffer);
+    if (!ggml_backend_buffer_is_host(out->buffer) || (bufname && strstr(bufname, "REPACK")) || out->ne[2] != 1 || out->ne[3] != 1) {
+        LLAMA_LOG_WARN("%s: vocabolario ridotto non applicabile (buffer '%s')\n", __func__, bufname ? bufname : "?");
+        return;
+    }
+    const int64_t n_vocab = out->ne[1];
+    std::vector<int32_t> ids;
+    if (FILE * f = fopen(path, "r")) {
+        long v;
+        while (fscanf(f, "%ld", &v) == 1) {
+            if (v >= 0 && v < n_vocab) {
+                ids.push_back((int32_t) v);
+            }
+        }
+        fclose(f);
+    } else {
+        LLAMA_LOG_WARN("%s: file %s non leggibile\n", __func__, path);
+        return;
+    }
+    std::sort(ids.begin(), ids.end());
+    ids.erase(std::unique(ids.begin(), ids.end()), ids.end());
+    if (ids.size() < 256 || (int64_t) ids.size() >= n_vocab) {
+        LLAMA_LOG_WARN("%s: sottoinsieme di %zu token ignorato\n", __func__, ids.size());
+        return;
+    }
+    ggml_init_params ip = { ggml_tensor_overhead() * 4, nullptr, true };
+    ggml_context * ctx = ggml_init(ip);
+    ggml_tensor * sub = ggml_new_tensor_2d(ctx, out->type, out->ne[0], (int64_t) ids.size());
+    ggml_set_name(sub, "output_sub");
+    ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors_from_buft(ctx, ggml_backend_cpu_buffer_type());
+    if (!buf) {
+        ggml_free(ctx);
+        return;
+    }
+    const size_t row = ggml_row_size(out->type, out->ne[0]);
+    for (size_t i = 0; i < ids.size(); i++) {
+        ggml_backend_tensor_set(sub, (const char *) out->data + (size_t) ids[i] * row, i * row, row);
+    }
+    g_vocab_sub.ids = std::move(ids);
+    g_vocab_sub.out_orig = out;
+    g_vocab_sub.out_sub = sub;
+    g_vocab_sub.ctx = ctx;
+    g_vocab_sub.buf = buf;
+    LLAMA_LOG_INFO("%s: vocabolario ridotto: %zu token su %lld, output %.1f MB invece di %.1f MB\n", __func__, g_vocab_sub.ids.size(),
+        (long long) n_vocab, ggml_backend_buffer_get_size(buf) / 1048576.0, ggml_nbytes(out) / 1048576.0);
+}
