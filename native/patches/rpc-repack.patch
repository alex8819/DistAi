+// DistAI: llama.cpp uses the CPU repack kernels (CPU_REPACK buffer type) only for weights loaded locally; on an RPC server
+// the weights live in plain CPU buffers and the prompt runs on the slow generic kernels (4-5x on ARM with Q4_0).
+// Repack each weight in place the first time it shows up as src0 of a matrix multiplication and point the graph tensor
+// at a CPU_REPACK buffer, so the CPU backend picks the same kernels as a local load. GGML_RPC_REPACK=0 disables it.
+static ggml_backend_buffer_type_t rpc_cpu_repack_buft() {
+    static ggml_backend_buffer_type_t buft = []() -> ggml_backend_buffer_type_t {
+        const char * env = getenv("GGML_RPC_REPACK");
+        if (env != nullptr && strcmp(env, "0") == 0) {
+            return nullptr;
+        }
+        ggml_backend_reg_t reg = ggml_backend_reg_by_name("CPU");
+        if (reg == nullptr) {
+            return nullptr;
+        }
+        auto get_extra = (ggml_backend_dev_get_extra_bufts_t) ggml_backend_reg_get_proc_address(reg, "ggml_backend_dev_get_extra_bufts");
+        if (get_extra == nullptr) {
+            return nullptr;
+        }
+        for (ggml_backend_buffer_type_t * b = get_extra(ggml_backend_reg_dev_get(reg, 0)); b && *b; ++b) {
+            if (strcmp(ggml_backend_buft_name(*b), "CPU_REPACK") == 0) {
+                return *b;
+            }
+        }
+        return nullptr;
+    }();
+    return buft;
+}
+
+// a write over a repacked weight puts it back in the standard layout
+void rpc_server::forget_repacked(const void * begin, size_t size) {
+    const char * b = (const char *) begin;
+    const char * e = b + size;
+    bool erased = false;
+    for (auto it = repacked.begin(); it != repacked.end(); ) {
+        const char * t = (const char *) it->first;
+        if (t < e && t + it->second.second > b) {
+            it = repacked.erase(it);
+            erased = true;
+        } else {
+            ++it;
+        }
+    }
+    for (auto it = not_repackable.begin(); it != not_repackable.end(); ) {
+        const char * t = (const char *) *it;
+        it = t >= b && t < e ? not_repackable.erase(it) : std::next(it);
+    }
+    if (erased) {
+        // cached graphs point these tensors at the repack buffer
+        for (auto & sgs : stored_graphs) {
+            for (auto & sg : sgs) {
+                sg.second.graph = nullptr;
+            }
+        }
+    }
+}
+
+void rpc_server::repack_weights(ggml_backend_t backend, ggml_cgraph * graph) {
+    ggml_backend_buffer_type_t buft = rpc_cpu_repack_buft();
+    if (buft == nullptr || ggml_backend_dev_type(ggml_backend_get_device(backend)) != GGML_BACKEND_DEVICE_TYPE_CPU) {
+        return;
+    }
+    if (repack_buf == nullptr) {
+        repack_buf = ggml_backend_buft_alloc_buffer(buft, 64);
+        if (repack_buf == nullptr) {
+            return;
+        }
+    }
+    auto is_weight = [](const ggml_tensor * t) {
+        return t != nullptr && t->op == GGML_OP_NONE && t->view_src == nullptr && t->buffer != nullptr && ggml_is_quantized(t->type);
+    };
+    auto is_matmul_src0 = [](const ggml_tensor * node, int j) {
+        return j == 0 && node->src[1] != nullptr && node->src[1]->type == GGML_TYPE_F32 &&
+               ((node->op == GGML_OP_MUL_MAT    && ggml_n_dims(node->src[0]) == 2) ||
+                (node->op == GGML_OP_MUL_MAT_ID && ggml_n_dims(node->src[0]) == 3));
+    };
+    // weights read by any other op (e.g. GET_ROWS on tied embeddings) keep the standard layout
+    for (int i = 0; i < graph->n_nodes; i++) {
+        ggml_tensor * node = graph->nodes[i];
+        for (int j = 0; node != nullptr && j < GGML_MAX_SRC; j++) {
+            ggml_tensor * s = node->src[j];
+            if (!is_weight(s) || is_matmul_src0(node, j)) {
+                continue;
+            }
+            if (repacked.find(s->data) != repacked.end()) {
+                GGML_LOG_ERROR("[%s] repacked weight %s used by %s: results will be wrong, restart with GGML_RPC_REPACK=0\n",
+                               __func__, s->name, ggml_op_name(node->op));
+            }
+            not_repackable.insert(s->data);
+        }
+    }
+    bool synced = false;
+    for (int i = 0; i < graph->n_nodes; i++) {
+        ggml_tensor * node = graph->nodes[i];
+        if (node == nullptr || !is_weight(node->src[0]) || !is_matmul_src0(node, 0)) {
+            continue;
+        }
+        ggml_tensor * s = node->src[0];
+        auto it = repacked.find(s->data);
+        if (it == repacked.end()) {
+            if (not_repackable.count(s->data)) {
+                continue;
+            }
+            void * extra = s->extra;
+            repack_buf->iface.init_tensor(repack_buf, s);  // sets s->extra to the repack traits, nullptr if none fits
+            if (s->extra == nullptr) {
+                s->extra = extra;
+                not_repackable.insert(s->data);
+                continue;
+            }
+            if (!synced) {
+                sync_all_backends();  // a previous graph may still be reading the weight
+                synced = true;
+            }
+            const size_t nbytes = ggml_nbytes(s);
+            std::vector<uint8_t> tmp((const uint8_t *) s->data, (const uint8_t *) s->data + nbytes);
+            repack_buf->iface.set_tensor(repack_buf, s, tmp.data(), 0, nbytes);
+            it = repacked.emplace(s->data, std::make_pair(s->extra, nbytes)).first;
+        }
+        s->extra  = it->second.first;
+        s->buffer = repack_buf;
+    }
+}
